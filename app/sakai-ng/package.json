{
    "name": "sakai-ng",
    "version": "21.0.0",
    "scripts": {
        "ng": "ng",
        "start": "ng serve",
        "build": "ng build",
        "watch": "ng build --watch --configuration development",
        "format": "prettier --write \"**/*.{js,mjs,ts,mts,d.ts,html}\" --cache",
        "storybook": "ng run sakai-ng:storybook",
        "build-storybook": "ng run sakai-ng:build-storybook",
        "capture": "npm run build-storybook && node scripts/capture-screenshots.mjs",
        "tokens": "node scripts/export-tokens.mjs",
        "figma:plan": "node scripts/figma-variables.mjs && node scripts/figma-verify.mjs",
        "figma:icons": "node scripts/figma-icons.mjs",
        "figma:button": "node scripts/figma-button.mjs",
        "figma:inputtext": "node scripts/figma-inputtext.mjs",
        "figma:tag": "node scripts/figma-tag.mjs",
        "figma:composite": "node scripts/figma-composite.mjs",
        "figma:textarea": "node scripts/figma-inputtext.mjs --set=textarea",
        "figma:datepicker": "node scripts/figma-datepicker.mjs",
        "figma:toggles": "node scripts/figma-toggles.mjs",
        "figma:select": "node scripts/figma-select.mjs",
        "figma:message": "node scripts/figma-message.mjs",
        "figma:datatable": "node scripts/figma-datatable.mjs",
        "figma:scrollbar": "node scripts/figma-scrollbar.mjs",
        "figma:splitbutton": "node scripts/figma-splitbutton.mjs",
        "figma:toolbar": "node scripts/figma-toolbar.mjs",
        "figma:dialog": "node scripts/figma-dialog.mjs",
        "figma:toast": "node scripts/figma-toast.mjs",
        "figma:menu": "node scripts/figma-menu.mjs",
        "figma:sidebarmenu": "node scripts/figma-sidebarmenu.mjs",
        "figma:tabs": "node scripts/figma-tabs.mjs",
        "figma:content": "node scripts/figma-content.mjs",
        "figma:display": "node scripts/figma-display.mjs",
        "figma:nav": "node scripts/figma-nav.mjs",
        "figma:forms2a": "node scripts/figma-forms2a.mjs",
        "figma:forms2b": "node scripts/figma-forms2b.mjs",
        "figma:fileupload": "node scripts/figma-fileupload.mjs",
        "figma:extras1": "node scripts/figma-extras1.mjs",
        "figma:tree": "node scripts/figma-tree.mjs",
        "figma:dataview": "node scripts/figma-dataview.mjs",
        "figma:chart": "node scripts/figma-chart.mjs"
    },
    "private": true,
    "dependencies": {
        "@angular/cdk": "^21.2.14",
        "@angular/common": "^21.2.26",
        "@angular/compiler": "^21.2.26",
        "@angular/core": "^21.2.26",
        "@angular/forms": "^21.2.26",
        "@angular/platform-browser": "^21.2.26",
        "@angular/platform-browser-dynamic": "^21.2.26",
        "@angular/router": "^21.2.26",
        "@primeuix/themes": "^2.0.0",
        "@tailwindcss/postcss": "^4.1.11",
        "chart.js": "4.4.2",
        "primeclt": "^0.1.5",
        "primeicons": "^7.0.0",
        "primeng": "^21.0.2",
        "quill": "^2.0.2",
        "rxjs": "~7.8.0",
        "tailwindcss-primeui": "^0.6.1",
        "tslib": "^2.8.1"
    },
    "devDependencies": {
        "@analogjs/vite-plugin-angular": "^2.9.7",
        "@angular-devkit/build-angular": "^21",
        "@angular/animations": "^21.2.26",
        "@angular/build": "^21.2.30",
        "@angular/cli": "^21",
        "@angular/compiler-cli": "^21.2.26",
        "@storybook/addon-a11y": "^10.6.7",
        "@storybook/addon-docs": "^10.6.7",
        "@storybook/angular-vite": "^10.6.7",
        "autoprefixer": "^10.4.20",
        "eslint": "^5.13.0",
        "eslint-config-prettier": "^6.15.0",
        "eslint-plugin-import": "^2.31.0",
        "eslint-plugin-prefer-arrow": "^1.2.3",
        "eslint-plugin-prettier": "^3.4.1",
        "opentype.js": "^2.0.0",
        "playwright": "^1.65.1",
        "postcss": "^8.5.6",
        "prettier": "^3.0.0",
        "storybook": "^10.6.7",
        "tailwindcss": "^4.1.11",
        "typescript": "~5.9.3",
        "vite": "^8.3.8"
    }
}
