{
  "$description": "Test brand A: indigo, sharp corners, roomy spacing, serif font.",
  "$metadata": {
    "theme": "test-brand-a",
    "base": "tokens/base/tokens.json",
    "purpose": "Pilot Day 6 theme-swap test. Not a client brand.",
    "rules": "Values only: every path must already exist in base/tokens.json with the same shape (single value or {light, dark}). No renames, no new tokens (SPEC 5.3).",
    "axes": {
      "primary": "indigo",
      "surface": "stone (light) / stone (dark)",
      "radius": "sharp: every radius 0",
      "density": "roomy (about +33%)",
      "fontFamily": "Georgia, 'Times New Roman', serif"
    },
    "notThemableByTokens": [
      {
        "axis": "font family",
        "wanted": "Georgia, 'Times New Roman', serif",
        "reason": "Aura has no font-family token; Sakai sets Lato in CSS (tokens/README 5.3). Expected Day 6 finding."
      },
      {
        "axis": "severity colors",
        "reason": "success/info/warn/danger/help component tokens reference primitive palettes directly (tokens/README 5.1); they do not follow this theme."
      },
      {
        "axis": "literal component values",
        "reason": "button.rounded-border-radius (2rem), button.icon-only-width, tag.padding, tag.font-size are literals in component tokens (tokens/README 5.3)."
      }
    ]
  },
  "primitives": {
